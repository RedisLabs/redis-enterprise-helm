{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "tenantId",
    "security",
    "license",
    "storage",
    "inference",
    "controlplane",
    "dataplane",
    "identityService",
    "tests"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "maxLength": 64
    },
    "auth": {
      "type": "object",
      "required": ["oidc"],
      "properties": {
        "oidc": {
          "type": "object",
          "description": "Settings shared by every Iris service that validates IdP access tokens.",
          "required": ["audience"],
          "properties": {
            "audience": {
              "type": "string",
              "minLength": 1,
              "description": "Audience accepted by the data plane and the control plane. There is no per-service override."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "required": [
        "profile"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "enum": [
            "",
            "fips"
          ]
        }
      }
    },
    "tls": {
      "type": "object",
      "required": [
        "caCertSecret",
        "caCertSecretChecksum"
      ],
      "properties": {
        "caCertSecret": {
          "type": "string"
        },
        "caCertSecretChecksum": {
          "type": "string"
        }
      }
    },
    "license": {
      "$ref": "#/definitions/secretReference"
    },
    "storage": {
      "type": "object",
      "required": [
        "existingSecret",
        "playbookKey",
        "existingSecretChecksum",
        "keyPrefix",
        "maxPlaybooksPerTenant"
      ],
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "playbookKey": {
          "type": "string",
          "minLength": 1
        },
        "identityServiceKey": {
          "not": {},
          "description": "Removed: the Identity Service metadata Secret belongs to the Identity Service release."
        },
        "existingSecretChecksum": {
          "type": "string"
        },
        "keyPrefix": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^*?\\[\\]{}[:space:]]+$"
        },
        "maxPlaybooksPerTenant": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "inference": {
      "type": "object",
      "required": [
        "existingSecret",
        "secretKey",
        "existingSecretChecksum",
        "models"
      ],
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "secretKey": {
          "type": "string",
          "minLength": 1
        },
        "existingSecretChecksum": {
          "type": "string"
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "provider",
              "model",
              "dimensions"
            ],
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "dimensions": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "connection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "issuer": {
              "type": "string"
            },
            "workerSubjects": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "identityServiceBaseURL": {
              "type": "string",
              "pattern": "^(|https?://[^[:space:]]+)$"
            },
            "destinationIdentityServiceBaseURL": {
              "type": "string",
              "pattern": "^(|https?://[^[:space:]]+)$"
            },
            "controlToken": {
              "type": "object",
              "description": "Removed (MOD-19110): the control plane uses its own ServiceAccount JWT. Setting it fails rendering with the replacement."
            },
            "allowInsecureTransport": {
              "type": "boolean"
            },
            "jwksURI": {
              "type": "string"
            },
            "destinationControlToken": {
              "type": "object",
              "description": "Removed (MOD-19110): the control plane uses its own ServiceAccount JWT. Setting it fails rendering with the replacement."
            },
            "ramControlPlaneBaseURL": {
              "type": "string"
            },
            "ramControlPlaneAudience": {
              "type": "string",
              "minLength": 1
            },
            "sourceControlAudience": {
              "type": "string",
              "minLength": 1
            },
            "destinationControlAudience": {
              "type": "string",
              "minLength": 1
            },
            "controlTokenExpirationSeconds": {
              "type": "integer",
              "minimum": 600
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "tenant_id",
              "store_id"
            ],
            "properties": {
              "tenant_id": {
                "type": "string"
              },
              "store_id": {
                "type": "string"
              },
              "namespace_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "controlplane": {
      "type": "object",
      "required": [
        "replicaCount",
        "image",
        "service",
        "adminToken",
        "internalToken"
      ],
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "service": {
          "$ref": "#/definitions/service"
        },
        "config": {
          "type": "object",
          "description": "Bring-your-own control-plane config. When existingSecret is set the chart renders no control-plane ConfigMap and mounts that Secret instead.",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "secretKey": {
              "type": "string",
              "minLength": 1
            },
            "existingSecretChecksum": {
              "type": "string"
            }
          }
        },
        "adminToken": {
          "$ref": "#/definitions/credentialReference"
        },
        "internalToken": {
          "$ref": "#/definitions/credentialReference"
        },
        "oidc": {
          "type": "object",
          "description": "Operator bearer tokens validated locally against the dataplane.oidc issuer, with the audience auth.oidc.audience.",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "audience": {
              "type": "array",
              "description": "Removed: set auth.oidc.audience. A non-empty value fails the render with a migration message.",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "dataplane": {
      "type": "object",
      "required": [
        "replicaCount",
        "image",
        "service",
        "identityServiceBaseURL",
        "oidc"
      ],
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "service": {
          "$ref": "#/definitions/service"
        },
        "identityServiceBaseURL": {
          "type": "string",
          "pattern": "^(|https?://[^[:space:]]+)$",
          "description": "URL of the Identity Service release the data plane introspects agent keys against. Required; must be https:// unless identityService.allowInsecureTransport=true outside fips."
        },
        "oidc": {
          "type": "object",
          "required": [
            "enabled",
            "issuer",
            "jwksURI",
            "tenantIDClaim",
            "staticTenantID",
            "roleClaims",
            "roleMappings",
            "allowInsecureTransport"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "issuer": {
              "type": "string",
              "pattern": "^(|https?://[^[:space:]]+)$"
            },
            "jwksURI": {
              "type": "string",
              "pattern": "^(|https?://[^[:space:]]+)$"
            },
            "tenantIDClaim": {
              "type": "string"
            },
            "staticTenantID": {
              "type": "string"
            },
            "roleClaims": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "roleMappings": {
              "type": "object",
              "additionalProperties": { "type": "string", "minLength": 1 }
            },
            "allowInsecureTransport": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "identityService": {
      "type": "object",
      "description": "Connection to the Identity Service release this chart does not deploy.",
      "properties": {
        "allowInsecureTransport": {
          "type": "boolean",
          "description": "Accept an http:// dataplane.identityServiceBaseURL, extraction.connection.identityServiceBaseURL or extraction.connection.destinationIdentityServiceBaseURL. Refused under the fips security profile."
        },
        "credential": {
          "type": "object",
          "description": "The data plane's runtime credential, provisioned by deployment automation and registered on the Identity Service release.",
          "properties": {
            "existingSecret": { "type": "string" },
            "secretKey": { "type": "string", "minLength": 1 },
            "existingSecretChecksum": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "global": {
      "type": "object",
      "description": "Umbrella-chart fallbacks read when the local value is empty: security.profile, imagePullSecrets, tls.caCertSecret."
    },
    "tests": {
      "type": "object",
      "required": [
        "enabled",
        "securityProfileImage"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "securityProfileImage": {
          "$ref": "#/definitions/image"
        }
      },
      "additionalProperties": false
    },
    "worker": {
      "type": "object",
      "properties": {
        "sourceURL": {"type": "string"},
        "sourceTokenAudience": {"type": "string", "minLength": 1},
        "sourceTokenExpirationSeconds": {"type": "integer", "minimum": 600},
        "timeout": {"type": "string"},
        "reasoningEffort": {"enum": ["", "none", "minimal", "low", "medium", "high", "xhigh"]},
        "maxInputTokens": {"type": "integer", "minimum": 1},
        "maxCompletionTokens": {"type": "integer", "minimum": 1},
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "region": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "scanConcurrency": {
          "type": "integer",
          "minimum": 1
        },
        "extractConcurrency": {
          "type": "integer",
          "minimum": 1
        },
        "shutdownTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "jobs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "faq-scan",
              "faq-extract"
            ]
          }
        }
      }
    }
  },
  "definitions": {
    "secretReference": {
      "type": "object",
      "required": [
        "existingSecret",
        "secretKey",
        "existingSecretChecksum"
      ],
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "secretKey": {
          "type": "string",
          "minLength": 1
        },
        "existingSecretChecksum": {
          "type": "string"
        }
      }
    },
    "credentialReference": {
      "type": "object",
      "required": [
        "existingSecret",
        "secretKey",
        "autoGenerate",
        "existingSecretChecksum"
      ],
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "secretKey": {
          "type": "string",
          "minLength": 1
        },
        "autoGenerate": {
          "type": "boolean"
        },
        "existingSecretChecksum": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "service": {
      "type": "object",
      "required": [
        "type",
        "port"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    }
  }
}
