{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "redis-agent-memory values",
  "description": "Schema for the redis-agent-memory Helm chart values. Enforced by `helm install`/`helm upgrade` via Helm's built-in JSON Schema validation (see https://helm.sh/docs/topics/charts/#schema-files). Anything not defined here is accepted \u2014 the schema's job is to catch typos and invalid values on the keys we care most about, not to document every field.",
  "type": "object",
  "properties": {
    "config": {
      "type": "object",
      "description": "Data-plane config source. Bring your own Secret (existingSecret) or let the chart render a ConfigMap (render=true) from .Values.shared + .Values.memory.",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "render": {
          "type": "boolean",
          "description": "When true (and no existingSecret), the chart renders the data-plane config into a ConfigMap from .Values.shared + .Values.memory."
        },
        "secretKey": {
          "type": "string"
        },
        "existingSecretChecksum": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "secrets": {
      "type": "object",
      "description": "Names of pre-created Secrets, each holding a YAML overlay mounted read-only and deep-merged over the base config by the loader at runtime. Holds the Redis connection URLs and API keys, keeping them out of values.yaml and the rendered ConfigMap. secretName alone is usually enough; additionalSecrets layers extra Secrets on top when you need to split credentials (for example, per region).",
      "properties": {
        "secretName": {
          "type": "string",
          "description": "Name of the pre-created Secret holding your credentials (Redis connection URLs, embedder/LLM API keys) as one YAML overlay document under overlayKey. For most deployments this single Secret is all you need."
        },
        "overlayKey": {
          "type": "string",
          "description": "Key inside each overlay Secret that holds the overlay YAML. Defaults to overlay.yaml."
        },
        "additionalSecrets": {
          "type": "array",
          "description": "Optional: names of extra Secrets layered on top of secretName, merged in order (later wins). Leave empty if one Secret is enough.",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "shared": {
      "type": "object",
      "description": "Config blocks common to the data plane and control plane (embedders structure, store metadata structure, endpoints), deep-merged under both .Values.memory and .Values.controlplane.configData. Freeform."
    },
    "memory": {
      "type": "object",
      "description": "Rendered data-plane config file body (snake_case), used when config.render=true. Structure only; Redis URLs and API keys arrive via the mounted secret overlays. Freeform \u2014 matches the on-prem data-plane config file schema."
    },
    "image": {
      "type": "object",
      "properties": {
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "tag"
      ]
    },
    "security": {
      "type": "object",
      "description": "Runtime security posture selector. The chart maps this value to GODEBUG=fips140=on|off, and each binary derives its injected profile from the effective Go runtime state.",
      "properties": {
        "profile": {
          "type": "string",
          "description": "Allowed values: \"\" (default, no app-level FIPS guardrails) or \"fips\" (opt-in FIPS-oriented posture). Any other value is rejected at install/upgrade time so typos can't silently fall back to the default posture.",
          "enum": [
            "",
            "fips"
          ]
        }
      },
      "additionalProperties": false
    },
    "tests": {
      "type": "object",
      "description": "Gate for the `helm test` hooks shipped with this chart. When enabled, the chart renders test Pods plus a minimal Role + RoleBinding scoped to `get` on the release Deployments. Defaults to false so clusters that never run `helm test` get no extra RBAC.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "When true, render the `helm test` hooks. Defaults to false."
        },
        "smoke": {
          "type": "object",
          "description": "Optional public API smoke test run by `helm test` when both tests.enabled and tests.smoke.enabled are true.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "When true with tests.enabled=true, render the public RAM API smoke test Pod."
            },
            "storeId": {
              "type": "string",
              "description": "Store ID configured in the mounted memory-dataplane config and used by the smoke test API paths.",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-zA-Z0-9-]+$"
            },
            "image": {
              "type": "object",
              "description": "Container image used to run the API smoke script.",
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "tag": {
                  "type": "string",
                  "minLength": 1
                },
                "pullPolicy": {
                  "type": "string",
                  "enum": [
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ]
                }
              },
              "additionalProperties": false
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "activeDeadlineSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "searchRetries": {
              "type": "integer",
              "minimum": 1
            },
            "searchRetryIntervalSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "asyncPromotion": {
              "type": "object",
              "description": "Optional worker-path smoke verification. When enabled, the smoke test waits for the session event to be promoted into long-term memory.",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "When true, wait for the worker to promote the smoke session event into long-term memory."
                },
                "promotionRetries": {
                  "type": "integer",
                  "minimum": 1
                },
                "promotionRetryIntervalSeconds": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "supportPackage": {
      "type": "object",
      "description": "Replicated Troubleshoot support-bundle/redactor specs for customer-generated RAM support packages.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "When true, render cluster-discoverable Troubleshoot SupportBundle and Redactor ConfigMaps."
        },
        "logLimits": {
          "type": "object",
          "description": "Limits for RAM server, worker, and optional control-plane pod log collection.",
          "properties": {
            "maxLines": {
              "type": "integer",
              "minimum": 1
            },
            "maxBytes": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "healthChecks": {
          "type": "object",
          "description": "In-cluster Troubleshoot HTTP health probes against RAM Services.",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "timeout": {
              "type": "string",
              "minLength": 1
            },
            "queueMonitorPath": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "healthCheckImage": {
          "type": "object",
          "description": "Troubleshoot image used by supportPackage.healthChecks runPod collectors.",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "additionalProperties": false
        },
        "healthCheckImagePullSecretName": {
          "type": "string"
        },
        "healthCheckPodTimeout": {
          "type": "string",
          "minLength": 1
        },
        "registryImages": {
          "type": "object",
          "description": "Native Troubleshoot registryImages collector/analyzer for chart-rendered images.",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "imagePullSecretName": {
              "type": "string"
            },
            "imagePullSecretType": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "nodeMetrics": {
          "type": "object",
          "description": "Kubernetes nodeMetrics collection plus native PVC usage analyzer.",
          "properties": {},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "preflight": {
      "type": "object",
      "description": "Static Kubernetes-only Replicated Troubleshoot Preflight spec rendered as a ConfigMap. A packaged copy is also shipped under support/ for pre-install checks.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "When true, render a ConfigMap containing data.preflight-spec with Kubernetes version, API, and default resource checks."
        }
      },
      "additionalProperties": false
    },
    "workerAuth": {
      "type": "object",
      "description": "Worker-to-RAM authentication preset. When enabled, the chart creates or uses a worker service account and mounts a projected Kubernetes service-account token for dataplane_client.auth.type=service_account_token. The shared config Secret must still configure auth.worker_identity.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "When true, render worker projected service-account token wiring with the defaults from worker.serviceAccount.token.*."
        }
      },
      "additionalProperties": false
    },
    "controlplane": {
      "type": "object",
      "description": "Bundled on-prem Control Plane (admin store API). Its image, config, admin-token source, and internal-token source are required.",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "additionalProperties": false
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "config": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "render": {
              "type": "boolean",
              "description": "When true (and no existingSecret), the chart renders the control-plane config into a ConfigMap from .Values.shared + .Values.controlplane.configData."
            },
            "secretKey": {
              "type": "string"
            },
            "existingSecretChecksum": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "configData": {
          "type": "object",
          "description": "Rendered control-plane config file body (snake_case), used when controlplane.config.render=true. Structure only; Redis URLs and API keys arrive via the mounted secret overlays. Freeform \u2014 matches the on-prem CP config file schema."
        },
        "adminToken": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "secretKey": {
              "type": "string",
              "minLength": 1
            },
            "autoGenerate": {
              "type": "boolean"
            },
            "existingSecretChecksum": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "internalToken": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "secretKey": {
              "type": "string",
              "minLength": 1
            },
            "autoGenerate": {
              "type": "boolean"
            },
            "existingSecretChecksum": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "affinity": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "volumes": {
          "type": "array"
        },
        "volumeMounts": {
          "type": "array"
        },
        "queueMonitor": {
          "type": "object",
          "description": "Optional Asynqmon UI for the on-prem regional Redis job queue backend. Disabled by default. When enabled, Redis credentials and Basic Auth htpasswd data must come from existing Secrets.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "When true, render a separate Asynqmon Deployment, Service, and optional dedicated-host Ingress."
            },
            "readOnly": {
              "type": "boolean",
              "description": "When true, run Asynqmon in read-only mode. Defaults to true."
            },
            "image": {
              "type": "object",
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "tag": {
                  "type": "string",
                  "minLength": 1
                },
                "pullPolicy": {
                  "type": "string",
                  "enum": [
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ]
                }
              },
              "additionalProperties": false
            },
            "replicaCount": {
              "type": "integer",
              "minimum": 0
            },
            "service": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "additionalProperties": false
            },
            "redis": {
              "type": "object",
              "description": "Existing Secret wiring for the same Redis queue backend configured in background_jobs.redis.",
              "properties": {
                "existingSecret": {
                  "type": "string"
                },
                "urlKey": {
                  "type": "string",
                  "minLength": 1
                },
                "tlsServerNameKey": {
                  "type": "string"
                },
                "insecureTLSKey": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "auth": {
              "type": "object",
              "description": "Ingress Basic Auth settings. existingSecret must be an htpasswd-formatted Kubernetes Secret.",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "basic"
                  ]
                },
                "existingSecret": {
                  "type": "string"
                },
                "secretKey": {
                  "type": "string",
                  "enum": [
                    "auth"
                  ]
                }
              },
              "additionalProperties": false
            },
            "ingress": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "className": {
                  "type": "string"
                },
                "host": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "pathType": {
                  "type": "string",
                  "enum": [
                    "Exact",
                    "Prefix",
                    "ImplementationSpecific"
                  ]
                },
                "annotations": {
                  "type": "object"
                },
                "tls": {
                  "type": "object",
                  "properties": {
                    "secretName": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "resources": {
              "type": "object"
            },
            "podAnnotations": {
              "type": "object"
            },
            "podLabels": {
              "type": "object"
            },
            "securityContext": {
              "type": "object"
            },
            "nodeSelector": {
              "type": "object"
            },
            "affinity": {
              "type": "object"
            },
            "tolerations": {
              "type": "array"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "identityService": {
      "type": "object",
      "description": "Suite-level Iris Identity Service deployment for on-prem agent-key lifecycle and runtime introspection. Enabled by default; requires identityService.image.tag and identityService.metadata.existingSecret.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "additionalProperties": false
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "config": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "render": {
              "type": "boolean"
            },
            "secretKey": {
              "type": "string",
              "minLength": 1
            },
            "existingSecretChecksum": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "configData": {
          "type": "object",
          "description": "Extra non-secret IdS config fields used with identityService.config.render=true. The chart owns mounted credential paths."
        },
        "metadata": {
          "type": "object",
          "description": "Pre-created Secret holding a YAML overlay with IdS metadata Redis connection details.",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "secretKey": {
              "type": "string",
              "minLength": 1
            },
            "existingSecretChecksum": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "controlToken": {
          "type": "object",
          "description": "IdS Control static admin credential.",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "secretKey": {
              "type": "string",
              "minLength": 1
            },
            "autoGenerate": {
              "type": "boolean"
            },
            "existingSecretChecksum": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "runtime": {
          "type": "object",
          "properties": {
            "cache": {
              "type": "object",
              "properties": {
                "softTtlSeconds": {
                  "type": "integer",
                  "minimum": 0
                },
                "hardTtlSeconds": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "unscopedGrantsProduct": {
              "type": "string",
              "description": "Product that owns grants stored before grants carried an explicit product. Must name a configured productValidation product, or be empty to ignore such grants. Limited to the products the Identity Service recognises.",
              "enum": [
                "",
                "memory",
                "langcache",
                "context"
              ]
            },
            "memoryCredentialName": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,44}$",
              "description": "Runtime credential name consumed by the packaged Agent Memory data plane when chart-rendered config enables IdS-backed API-key introspection."
            },
            "serviceCredentials": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]{1,44}$",
                    "description": "Stable credential name used for generated Secret names and mounted token_file paths."
                  },
                  "subject": {
                    "type": "string",
                    "minLength": 1
                  },
                  "existingSecret": {
                    "type": "string"
                  },
                  "secretKey": {
                    "type": "string",
                    "minLength": 1
                  },
                  "autoGenerate": {
                    "type": "boolean"
                  },
                  "existingSecretChecksum": {
                    "type": "string"
                  },
                  "allowedOperations": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "api-key-introspect",
                        "auth-introspect",
                        "auth-me"
                      ],
                      "description": "Operation the runtime service credential may perform, in canonical lowercase. An unrecognised name grants nothing, so it is rejected here rather than surfacing as a 403 at request time. The Identity Service itself compares operation names case-insensitively, so this enum is deliberately stricter: chart values are a curated surface and rendered config should be uniform, matching how the chart already requires canonical lowercase product names."
                    }
                  },
                  "allowedProducts": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "memory",
                        "langcache",
                        "context"
                      ]
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "productValidation": {
          "type": "object",
          "description": "Product control planes that IdS calls before persisting API-key grants.",
          "properties": {
            "products": {
              "type": "object",
              "minProperties": 1,
              "patternProperties": {
                "^[a-z0-9-]{1,44}$": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "baseURL": {
                      "type": "string"
                    },
                    "credential": {
                      "type": "object",
                      "properties": {
                        "existingSecret": {
                          "type": "string"
                        },
                        "secretKey": {
                          "type": "string",
                          "minLength": 1
                        },
                        "existingSecretChecksum": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false,
              "propertyNames": {
                "enum": [
                  "memory",
                  "langcache",
                  "context"
                ]
              }
            }
          },
          "required": [
            "products"
          ],
          "additionalProperties": false
        },
        "apiKeys": {
          "type": "object",
          "properties": {
            "maxRotateGraceSeconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "additionalProperties": false
        },
        "livenessProbe": {
          "type": "object"
        },
        "readinessProbe": {
          "type": "object"
        },
        "resources": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "affinity": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "volumes": {
          "type": "array"
        },
        "volumeMounts": {
          "type": "array"
        }
      },
      "additionalProperties": false
    }
  }
}
